<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TextureTinter.ViewModels"
             x:Class="TextureTinter.Views.Stage3View"
             x:DataType="vm:MainViewModel">
  <Border Classes="card">
    <StackPanel Spacing="14">
      <TextBlock Text="Export" FontSize="18" FontWeight="SemiBold"/>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="File name pattern" VerticalAlignment="Center" Width="150"
                   Foreground="{StaticResource TextSecondary}"/>
        <TextBox Width="320" Text="{Binding Pattern, Mode=TwoWay}"/>
        <TextBlock Text="{}{dye}   {name}   {cat}" VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondary}"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Destination" VerticalAlignment="Center" Width="150"
                   Foreground="{StaticResource TextSecondary}"/>
        <TextBox Width="440" Text="{Binding ExportDir, Mode=OneWay}" IsReadOnly="True"/>
        <Button Content="Select..." Command="{Binding PickDestinationCommand}"/>
      </StackPanel>

      <Button Classes="accent" HorizontalAlignment="Left"
              Content="Export all textures × all dyes"
              Command="{Binding ExportCommand}"/>
    </StackPanel>
  </Border>
</UserControl>